{
  "name": "@musai/distribution",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "bin": {
    "musai": "./dist/bin/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-artefacts.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "conformance": "node --import ../test-support/src/ts-esm.mjs scripts/conformance-export.ts"
  },
  "dependencies": {
    "@musai/api-core": "workspace:*",
    "@musai/cli": "workspace:*",
    "@musai/devkit": "workspace:*",
    "@musai/evaluate": "workspace:*",
    "@musai/fold": "workspace:*",
    "@musai/mcp": "workspace:*",
    "@musai/modules": "workspace:*",
    "@musai/records": "workspace:*",
    "@musai/run": "workspace:*",
    "@musai/store": "workspace:*",
    "@musai/trust": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.3",
    "execa": "10.0.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
