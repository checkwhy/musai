{
  "name": "@musai/devkit",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/templates', 'dist/templates', { recursive: true })\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@musai/evaluate": "workspace:*",
    "@musai/fold": "workspace:*",
    "@musai/modules": "workspace:*",
    "@musai/records": "workspace:*",
    "@musai/run": "workspace:*",
    "@musai/store": "workspace:*",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "packageurl-js": "2.0.1"
  },
  "devDependencies": {
    "@musai/trust": "workspace:*",
    "@types/node": "24.13.3",
    "execa": "10.0.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
