# The corpus the kernel writes passes against this verifier, case by case.
exec musai-verify conformance $CONFORMANCE
stdout '^pass  canonical  empty-object$'
stdout '^pass  differential  3000 values$'
stdout '^pass  references  the table this verifier embeds$'
stdout '^pass  roles  the role table this verifier embeds$'
stdout '^pass  roles  owner at scope any$'
stdout '^pass  roles  an empty trust branch$'
stdout '^pass  audiences  100 pairs$'
stdout '^pass  allowed-signers  a name and its key$'
stdout '^pass  allowed-signers  a principal naming another key''s form$'
stdout '^pass  bundles  salted$'
stdout '^pass  bundles  wrong-kind-directory$'
stdout '^pass  releases  revoked$'
stdout '^pass  releases  revoked-unsigned$'
stdout '^pass  releases  revoked-unsigned-unauthorised$'
stdout '^pass  releases  later-version-superseding$'
stdout '^pass  releases  later-version-revocation$'
stdout '^pass  releases  later-version-revocation-malformed$'
stdout '^pass  releases  superseded-across-subjects$'
stdout '^pass  exports  released$'
stdout '^pass  frozen  attestation-by-key$'
stdout '^pass  recipes  a nested working directory, literals out of order and declared names, one secret$'
stdout '^pass  recipes  a run declaring no image$'
stdout '^passed: 194 of 194 cases$'
! stdout '^fail'
